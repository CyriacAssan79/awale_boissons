# Copier ce fichier en `.env` (jamais commité, voir .gitignore) et
# renseigner les valeurs réelles.

# Clé API OpenAI — utilisée uniquement par ai/classify_comments.py
# (première version, non retenue en production : voir docs/ai_documentation.ipynb).
# Le pipeline de production (classify_comments_hybrid.py / classify_comments_local.py)
# tourne en local avec Qwen2.5-0.5B-Instruct et n'a besoin d'aucune clé.
OPENAI_API_KEY=

# Optionnel — surcharge les chemins par défaut (utile en CI ou pour isoler
# un run de test). Par défaut, tout est résolu relativement à la racine
# du projet, aucune valeur n'est requise ici.
# AWALE_DUCKDB_PATH=../data/awale.duckdb
# AWALE_RAW_DIR=./data/raw
