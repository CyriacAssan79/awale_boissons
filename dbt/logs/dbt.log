[0m12:21:16.752771 [debug] [Thread-1 (]: On model.awale_reporting.stg_social_comments: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "awale_reporting", "target_name": "dev", "node_id": "model.awale_reporting.stg_social_comments"} */

  
  create view "awale"."main"."stg_social_comments__dbt_tmp" as (
    WITH source_data AS (

    SELECT
        comment_id,
        platform,
        post_id,
        published_at,
        author_handle,
        comment_text,
        like_count,
        reply_to_id
    FROM "awale"."main"."raw_social_comments"

),

with_duplicate_info AS (

    SELECT
        *,
        COUNT(*) OVER (
            PARTITION BY
                comment_id,
                platform,
                post_id,
                published_at,
                author_handle,
                comment_text,
                like_count,
                reply_to_id
        ) AS exact_duplicate_count
    FROM source_data

),

deduplicated AS (

    SELECT *
    FROM with_duplicate_info
    WHERE
        ROW_NUMBER() OVER (
            PARTITION BY
                comment_id,
                platform,
                post_id,
                published_at,
                author_handle,
                comment_text,
                like_count,
                reply_to_id
            ORDER BY comment_id
        ) = 1

)

SELECT

    /* ============================================================
       IDENTIFIERS
       ============================================================ */

    TRIM(comment_id) AS comment_id,

    TRIM(post_id) AS post_id,

    TRIM(author_handle) AS author_handle,

    /* ============================================================
       PLATFORM
       ============================================================ */

    TRIM(platform) AS platform_raw,

    CASE
        WHEN LOWER(TRIM(platform)) = 'instagram'
            THEN 'Instagram'

