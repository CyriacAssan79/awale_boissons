    create  table
      "awale"."main"."mart_channel_performance_monthly__dbt_tmp"
  
    
    as (
      

WITH marketing AS (

    SELECT
        month,
        channel,
        campaign_spend_fcfa,
        planned_budget_fcfa,
        media_plan_invoiced_fcfa,
        known_variance_fcfa,
        impressions,
        clicks
    FROM "awale"."main"."mart_marketing_channel_monthly"

),

sales AS (

    SELECT
        month,
        net_revenue_fcfa,
        net_units_sold,
        gross_revenue_fcfa,
        return_revenue_fcfa,
        missing_sales_days
    FROM "awale"."main"."mart_sales_monthly"

)

SELECT
    m.month,
    m.channel,

    m.campaign_spend_fcfa,
    m.planned_budget_fcfa,
    m.media_plan_invoiced_fcfa,
    m.known_variance_fcfa,

    m.impressions,
    m.clicks,

    s.net_revenue_fcfa,
    s.net_units_sold,
    s.gross_revenue_fcfa,
    s.return_revenue_fcfa,
    s.missing_sales_days

FROM marketing m

LEFT JOIN sales s
    ON m.month = s.month
    );
    
  
