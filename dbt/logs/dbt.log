    create  table
      "awale"."main"."mart_sales_monthly__dbt_tmp"
  
    
    as (
      

WITH sales AS (

    SELECT
        sale_date,
        pos_id,
        pos_name,
        commune,
        channel,
        units_sold,
        revenue_fcfa,
        gross_units,
        return_units,
        gross_revenue_fcfa,
        return_revenue_fcfa,
        net_revenue_fcfa
    FROM "awale"."main"."stg_pos_sales_daily"

),

calendar AS (

    SELECT
        sale_date,
        has_sales_data,
        is_missing_sales_day
    FROM "awale"."main"."int_sales_calendar"

),

monthly_sales AS (

    SELECT
        DATE_TRUNC('month', s.sale_date) AS month,

        SUM(s.units_sold) AS net_units_sold,
        SUM(s.revenue_fcfa) AS net_revenue_fcfa,

        SUM(s.gross_units) AS gross_units,
        SUM(s.gross_revenue_fcfa) AS gross_revenue_fcfa,

        SUM(s.return_units) AS return_units,
        SUM(s.return_revenue_fcfa) AS return_revenue_fcfa,

        COUNT(DISTINCT s.pos_id) AS active_pos,
        COUNT(DISTINCT s.pos_name) AS active_pos_names,
        COUNT(DISTINCT s.commune) AS active_communes,

        COUNT(DISTINCT s.sale_date) AS observed_sales_days

    FROM sales s

    GROUP BY
        DATE_TRUNC('month', s.sale_date)

),

calendar_summary AS (

    SELECT
        DATE_TRUNC('month', sale_date) AS month,

        COUNT(*) AS calendar_days,

        SUM(
            CASE
                WHEN has_sales_data THEN 1
                ELSE 0
            END
        ) AS days_with_sales_data,

        SUM(
            CASE
                WHEN is_missing_sales_day THEN 1
                ELSE 0
            END
        ) AS missing_sales_days

    FROM calendar

    GROUP BY
        DATE_TRUNC('month', sale_date)

)

SELECT
    m.month,

    m.net_units_sold,
    m.net_revenue_fcfa,

    m.gross_units,
    m.gross_revenue_fcfa,

    m.return_units,
    m.return_revenue_fcfa,

    m.active_pos,
    m.active_pos_names,
    m.active_communes,

    m.observed_sales_days,

    c.calendar_days,
    c.days_with_sales_data,
    c.missing_sales_days,

    CASE
        WHEN c.days_with_sales_data > 0
        THEN m.net_revenue_fcfa / c.days_with_sales_data
        ELSE NULL
    END AS avg_revenue_per_observed_day,

    CASE
        WHEN m.gross_revenue_fcfa <> 0
        THEN ABS(m.return_revenue_fcfa)
             / m.gross_revenue_fcfa
        ELSE NULL
    END AS return_rate_revenue

FROM monthly_sales m

LEFT JOIN calendar_summary c
    ON m.month = c.month
    );
    
  
[0m00:29:16.335624 [debug] [Thread-3 (]: SQL status: OK in 0.004 seconds
[0m00:29:16.336162 [debug] [Thread-1 (]: On model.awale_reporting.mart_marketing_channel_monthly: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "awale_reporting", "target_name": "dev", "node_id": "model.awale_reporting.mart_marketing_channel_monthly"} */

    

    create  table
      "awale"."main"."mart_marketing_channel_monthly__dbt_tmp"
  
    
    as (
      

WITH reconciliation AS (

    SELECT
        month,
        channel,
        campaign_spend_fcfa,
        campaign_rows,
        impressions,
        clicks,
        planned_budget_fcfa,
        media_plan_invoiced_fcfa,
        campaign_vs_invoiced_variance_fcfa,
        source_coverage
    FROM "awale"."main"."int_media_reconciliation"

),

campaign_products AS (

    SELECT
        campaign_month AS month,
        platform AS channel,

        COUNT(*) AS campaign_count,

        COUNT_IF(product = 'bissap') AS bissap_campaigns,
        COUNT_IF(product = 'gingembre') AS gingembre_campaigns,
        COUNT_IF(product = 'bouye') AS bouye_campaigns,

        COUNT_IF(product IS NULL) AS campaigns_without_product,

        SUM(CASE WHEN product_parse_failed THEN 1 ELSE 0 END)
            AS product_parse_failure_count,

        SUM(
            CASE
                WHEN campaign_month_parse_failed THEN 1
                ELSE 0
            END
        ) AS month_parse_failure_count

    FROM "awale"."main"."int_campaign_normalized"

    GROUP BY
        campaign_month,
        platform

)

SELECT
    r.month,
    r.channel,

    COALESCE(r.campaign_spend_fcfa, 0) AS campaign_spend_fcfa,
    COALESCE(r.media_plan_planned_fcfa, 0) AS planned_budget_fcfa,
    r.media_plan_invoiced_fcfa,

    r.known_variance_fcfa,
    r.source_coverage,

    COALESCE(r.campaign_rows, 0) AS campaign_rows,

    r.impressions,
    r.clicks,

    CASE
        WHEN r.clicks > 0
        THEN r.campaign_spend_fcfa / r.clicks
        ELSE NULL
    END AS cpc_fcfa,

    CASE
        WHEN r.impressions > 0
        THEN r.campaign_spend_fcfa / r.impressions * 1000
        ELSE NULL
    END AS cpm_fcfa,

    COALESCE(cp.campaign_count, 0) AS campaign_count,
    COALESCE(cp.bissap_campaigns, 0) AS bissap_campaigns,
    COALESCE(cp.gingembre_campaigns, 0) AS gingembre_campaigns,
    COALESCE(cp.bouye_campaigns, 0) AS bouye_campaigns,
    COALESCE(cp.campaigns_without_product, 0)
        AS campaigns_without_product,
    COALESCE(cp.product_parse_failure_count, 0)
        AS product_parse_failure_count,
    COALESCE(cp.month_parse_failure_count, 0)
        AS month_parse_failure_count

FROM reconciliation r

LEFT JOIN campaign_products cp
    ON r.month = cp.month
   AND r.channel = cp.channel
    );
    
  
[0m00:29:16.338467 [debug] [Thread-3 (]: Using duckdb connection "model.awale_reporting.mart_whatsapp_monthly"
[0m00:29:16.340688 [debug] [Thread-3 (]: On model.awale_reporting.mart_whatsapp_monthly: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "awale_reporting", "target_name": "dev", "node_id": "model.awale_reporting.mart_whatsapp_monthly"} */

    

    create  table
      "awale"."main"."mart_whatsapp_monthly__dbt_tmp"
  
    
    as (
      

WITH orders AS (

    SELECT
        whatsapp_row_id,
        received_at,
        amount_fcfa,
        amount_missing,
        status,
        item_line_count,
        parsed_item_lines,
        unresolved_item_lines,
        missing_format_lines,
        quantity_total,
        order_parse_status
    FROM "awale"."main"."int_whatsapp_order_quality"

),

items AS (

    SELECT
        whatsapp_row_id,
        product,
        format,
        quantity
    FROM "awale"."main"."int_whatsapp_items"

),

item_summary AS (

    SELECT
        whatsapp_row_id,

        SUM(
            CASE WHEN product = 'bissap'
                 THEN quantity ELSE 0 END
        ) AS bissap_units,

        SUM(
            CASE WHEN product = 'gingembre'
                 THEN quantity ELSE 0 END
        ) AS gingembre_units,

        SUM(
            CASE WHEN product = 'bouye'
                 THEN quantity ELSE 0 END
        ) AS bouye_units,

        SUM(
            CASE WHEN format = '1L'
                 THEN quantity ELSE 0 END
        ) AS format_1l_units,

        SUM(
            CASE WHEN format = '33cl'
                 THEN quantity ELSE 0 END
        ) AS format_33cl_units

    FROM items
    GROUP BY whatsapp_row_id

)

SELECT
    DATE_TRUNC('month', o.received_at) AS month,

    COUNT(*) AS orders,

    COUNT_IF(status = 'delivered') AS delivered_orders,
    COUNT_IF(status = 'cancelled') AS cancelled_orders,
    COUNT_IF(status = 'pending') AS pending_orders,

    COUNT_IF(amount_missing) AS amount_missing_orders,

    COUNT_IF(order_parse_status = 'fully_parsed')
        AS fully_parsed_orders,

    COUNT_IF(order_parse_status = 'missing_format_only')
        AS missing_format_orders,

    COUNT_IF(order_parse_status = 'unresolved')
        AS unresolved_orders,

    SUM(quantity_total) AS total_units,

    SUM(COALESCE(i.bissap_units, 0)) AS bissap_units,
    SUM(COALESCE(i.gingembre_units, 0)) AS gingembre_units,
    SUM(COALESCE(i.bouye_units, 0)) AS bouye_units,

    SUM(COALESCE(i.format_1l_units, 0)) AS format_1l_units,
    SUM(COALESCE(i.format_33cl_units, 0)) AS format_33cl_units,

    SUM(CASE
        WHEN amount_fcfa IS NOT NULL
        THEN amount_fcfa
        ELSE 0
    END) AS known_order_amount_fcfa

FROM orders o

LEFT JOIN item_summary i
    ON o.whatsapp_row_id = i.whatsapp_row_id

GROUP BY 1
    );
    
  
