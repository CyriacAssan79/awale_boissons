  create view "awale"."main"."stg_campaign_spend__dbt_tmp" as (
    WITH source_data AS (

    SELECT
        platform,
        campaign_name,
        date_start,
        date_end,
        spend,
        impressions,
        clicks,
        objective,

        -- Déduplication uniquement des lignes
        -- totalement identiques.
        ROW_NUMBER() OVER (
            PARTITION BY
                platform,
                campaign_name,
                date_start,
                date_end,
                spend,
                impressions,
                clicks,
                objective
            ORDER BY
                platform
        ) AS exact_duplicate_rank

    FROM "awale"."main"."raw_campaign_spend_export"

),

deduplicated AS (

    SELECT
        platform,
        campaign_name,
        date_start,
        date_end,
        spend,
        impressions,
        clicks,
        objective

    FROM source_data

    WHERE exact_duplicate_rank = 1

),

cleaned_text AS (

    SELECT

        /* ============================================================
           RAW / TEXT
           ============================================================ */

        TRIM(platform) AS platform_raw,

        TRIM(campaign_name) AS campaign_name,

        TRIM(campaign_name) AS campaign_name_raw,

        TRIM(date_start) AS date_start_raw,

        TRIM(date_end) AS date_end_raw,

        TRIM(spend) AS spend_raw,

        TRIM(objective) AS objective_raw,

        impressions,

        clicks,

        /* ============================================================
           PLATFORM NORMALIZATION
           ============================================================ */

        CASE
            WHEN LOWER(TRIM(platform)) IN ('meta')
                THEN 'Meta'

            WHEN LOWER(TRIM(platform)) IN ('tiktok')
                THEN 'TikTok'

            WHEN LOWER(TRIM(platform)) IN ('google ads', 'google')
                THEN 'Google'

            WHEN LOWER(TRIM(platform)) IN ('influenceur', 'influenceurs')
                THEN 'Influenceurs'

            WHEN LOWER(TRIM(platform)) = 'radio'
                THEN 'Radio'

            ELSE TRIM(platform)
        END AS platform_normalized,

        /* ============================================================
           OBJECTIVE NORMALIZATION
           ============================================================ */

        CASE

            WHEN LOWER(TRIM(objective)) IN (
                'traffic',
                'trafic'
            )
                THEN 'traffic'

            WHEN LOWER(TRIM(objective)) = 'engagement'
                THEN 'engagement'

            WHEN LOWER(TRIM(objective)) IN (
                'notoriété',
                'notoriete',
                'awareness'
            )
                THEN 'awareness'

            WHEN LOWER(TRIM(objective)) IN (
                'conversions',
                'conv'
            )
                THEN 'conversions'

            ELSE LOWER(TRIM(objective))

        END AS objective_normalized

    FROM deduplicated

),

parsed_dates AS (

    SELECT
        *,

        /* ============================================================
           DATE START
           Supports:
           - YYYY-MM-DD
           - DD/MM/YYYY
           - French month names
           ============================================================ */

        CASE

            WHEN TRY_STRPTIME(
                date_start_raw,
                '%Y-%m-%d'
            ) IS NOT NULL
                THEN TRY_STRPTIME(
                    date_start_raw,
                    '%Y-%m-%d'
                )::DATE

            WHEN TRY_STRPTIME(
                date_start_raw,
                '%d/%m/%Y'
            ) IS NOT NULL
                THEN TRY_STRPTIME(
                    date_start_raw,
                    '%d/%m/%Y'
                )::DATE

            ELSE TRY_CAST(
                CASE
                    WHEN LOWER(date_start_raw) LIKE '%janvier%'
                        THEN REPLACE(
                            LOWER(date_start_raw),
                            'janvier',
                            '01'
                        )

                    WHEN LOWER(date_start_raw) LIKE '%février%'
                        THEN REPLACE(
                            LOWER(date_start_raw),
                            'février',
                            '02'
                        )

                    WHEN LOWER(date_start_raw) LIKE '%fevrier%'
                        THEN REPLACE(
                            LOWER(date_start_raw),
                            'fevrier',
                            '02'
                        )

                    WHEN LOWER(date_start_raw) LIKE '%mars%'
                        THEN REPLACE(
                            LOWER(date_start_raw),
                            'mars',
                            '03'
                        )

                    WHEN LOWER(date_start_raw) LIKE '%avril%'
                        THEN REPLACE(
                            LOWER(date_start_raw),
                            'avril',
                            '04'
                        )

                    WHEN LOWER(date_start_raw) LIKE '%mai%'
                        THEN REPLACE(
                            LOWER(date_start_raw),
                            'mai',
                            '05'
                        )

                    WHEN LOWER(date_start_raw) LIKE '%juin%'
                        THEN REPLACE(
                            LOWER(date_start_raw),
                            'juin',
                            '06'
                        )

                    ELSE NULL
                END AS DATE
            )

        END AS date_start,

        /* ============================================================
           DATE END
           ============================================================ */

        CASE

            WHEN TRY_STRPTIME(
                date_end_raw,
                '%Y-%m-%d'
            ) IS NOT NULL
                THEN TRY_STRPTIME(
                    date_end_raw,
                    '%Y-%m-%d'
                )::DATE

            WHEN TRY_STRPTIME(
                date_end_raw,
                '%d/%m/%Y'
            ) IS NOT NULL
                THEN TRY_STRPTIME(
                    date_end_raw,
                    '%d/%m/%Y'
                )::DATE

            ELSE TRY_CAST(
                CASE
                    WHEN LOWER(date_end_raw) LIKE '%janvier%'
                        THEN REPLACE(
                            LOWER(date_end_raw),
                            'janvier',
                            '01'
                        )

                    WHEN LOWER(date_end_raw) LIKE '%février%'
                        THEN REPLACE(
                            LOWER(date_end_raw),
                            'février',
                            '02'
                        )

                    WHEN LOWER(date_end_raw) LIKE '%fevrier%'
                        THEN REPLACE(
                            LOWER(date_end_raw),
                            'fevrier',
                            '02'
                        )

                    WHEN LOWER(date_end_raw) LIKE '%mars%'
                        THEN REPLACE(
                            LOWER(date_end_raw),
                            'mars',
                            '03'
                        )

                    WHEN LOWER(date_end_raw) LIKE '%avril%'
                        THEN REPLACE(
                            LOWER(date_end_raw),
                            'avril',
                            '04'
                        )

                    WHEN LOWER(date_end_raw) LIKE '%mai%'
                        THEN REPLACE(
                            LOWER(date_end_raw),
                            'mai',
                            '05'
                        )

                    WHEN LOWER(date_end_raw) LIKE '%juin%'
                        THEN REPLACE(
                            LOWER(date_end_raw),
                            'juin',
                            '06'
                        )

                    ELSE NULL
                END AS DATE
            )

        END AS date_end

    FROM cleaned_text

),

parsed_spend AS (

    SELECT
        *,

        /* ============================================================
           CURRENCY
           ============================================================ */

        CASE
            WHEN UPPER(spend_raw) LIKE '%EUR%'
                THEN 'EUR'

            ELSE 'FCFA'
        END AS spend_currency,

        /* ============================================================
           NUMERIC AMOUNT
           
           Examples:
           325 000 FCFA -> 325000
           500 000 FCFA -> 500000
           423,81 EUR   -> 423.81
           ============================================================ */

        TRY_CAST(
            REPLACE(
                REGEXP_REPLACE(
                    REPLACE(
                        REPLACE(
                            UPPER(spend_raw),
                            'FCFA',
                            ''
                        ),
                        'EUR',
                        ''
                    ),
                    '[^0-9,.\-]',
                    '',
                    'g'
                ),
                ',',
                '.'
            ) AS DOUBLE
        ) AS spend_amount

    FROM parsed_dates

)

SELECT

    /* ================================================================
       IDENTIFICATION
       ================================================================ */

    platform_normalized AS platform,

    platform_raw,

    campaign_name,

    campaign_name_raw,

    /* ================================================================
       DATES
       ================================================================ */

    date_start,

    date_end,

    date_start_raw,

    date_end_raw,

    DATE_TRUNC(
        'month',
        date_start
    )::DATE AS month,

    /* ================================================================
       SPEND
       ================================================================ */

    spend_raw,

    spend_currency,

    spend_amount,

    /*
       Challenge rule:
       1 EUR = 655 FCFA
    */

    CASE
        WHEN spend_currency = 'EUR'
            THEN 655.0
        ELSE 1.0
    END AS fx_rate_to_fcfa,

    ROUND(
        CASE
            WHEN spend_currency = 'EUR'
                THEN spend_amount * 655.0
            ELSE spend_amount
        END,
        2
    ) AS spend_fcfa,

    /* ================================================================
       DIGITAL PERFORMANCE
       ================================================================ */

    impressions,

    clicks,

    /* ================================================================
       OBJECTIVE
       ================================================================ */

    objective_raw,

    objective_normalized,

    /* ================================================================
       DATA QUALITY FLAGS
       ================================================================ */

    date_start IS NULL AS date_start_parse_failed,

    date_end IS NULL AS date_end_parse_failed,

    spend_amount IS NULL AS spend_parse_failed,

    date_start > date_end AS invalid_date_range,

    spend_currency = 'EUR' AS converted_from_eur,

    impressions IS NULL AS impressions_missing,

    clicks IS NULL AS clicks_missing

FROM parsed_spend
  );

