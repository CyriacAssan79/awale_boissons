    a.recent_3m_spend_fcfa,
    a.earlier_3m_spend_fcfa,

    CASE
        WHEN a.earlier_3m_spend_fcfa > 0
        THEN (
            a.recent_3m_spend_fcfa
            / a.earlier_3m_spend_fcfa
        ) - 1
        ELSE NULL
    END AS recent_vs_earlier_spend_change,

    CASE
        WHEN a.active_months = 6
            THEN 'full_6_months'
        ELSE 'partial_period'
    END AS period_coverage,

    a.data_quality_status

FROM aggregated a
    );
    
  
