[0m00:14:18.515901 [debug] [Thread-1 (]: On model.awale_reporting.int_whatsapp_order_quality: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "awale_reporting", "target_name": "dev", "node_id": "model.awale_reporting.int_whatsapp_order_quality"} */

  
  create view "awale"."main"."int_whatsapp_order_quality__dbt_tmp" as (
    WITH items AS (

    SELECT
        whatsapp_row_id,
        order_ref,
        amount_fcfa,
        status,
        quantity,
        parse_status,
        product,
        format
    FROM "awale"."main"."int_whatsapp_items"

),

order_quality AS (

    SELECT
        whatsapp_row_id,
        MAX(order_ref) AS order_ref,
        MAX(amount_fcfa) AS amount_fcfa,
        MAX(status) AS status,

        CASE
            WHEN MAX(amount_fcfa) IS NULL THEN TRUE
            ELSE FALSE
        END AS amount_missing,

        COUNT(*) AS item_line_count,

        SUM(
            CASE
                WHEN parse_status = 'parsed' THEN 1
                ELSE 0
            END
        ) AS parsed_item_lines,

        SUM(
            CASE
                WHEN parse_status = 'unknown_product' THEN 1
                ELSE 0
            END
        ) AS unresolved_item_lines,

        SUM(
            CASE
                WHEN parse_status = 'missing_format' THEN 1
                ELSE 0
            END
        ) AS missing_format_lines,

        BOOL_OR(product IS NULL) AS has_unknown_product,

        BOOL_OR(
            product IS NOT NULL
            AND format IS NULL
        ) AS has_missing_format,

        SUM(
            CASE
                WHEN quantity IS NOT NULL
                THEN quantity
                ELSE 0
            END
        ) AS quantity_total

    FROM items

    GROUP BY whatsapp_row_id

)

SELECT
    *,
    CASE
        WHEN parsed_item_lines = item_line_count
            THEN 'fully_parsed'

        WHEN parsed_item_lines > 0
             AND unresolved_item_lines > 0
            THEN 'partially_parsed'

        WHEN missing_format_lines = item_line_count
             AND item_line_count > 0
            THEN 'missing_format_only'

        ELSE 'unresolved'
    END AS order_parse_status

FROM order_quality
  );

