[0m00:40:26.995556 [debug] [Thread-4 (]: On model.awale_reporting.mart_channel_performance_monthly: /* {"app": "dbt", "dbt_version": "1.12.4", "profile_name": "awale_reporting", "target_name": "dev", "node_id": "model.awale_reporting.mart_channel_performance_monthly"} */

    

    create  table
      "awale"."main"."mart_channel_performance_monthly__dbt_tmp"
  
    
    as (
      

WITH marketing AS (

    SELECT
        month,
        channel,
        campaign_spend_fcfa,
        planned_budget_fcfa,
        invoiced_fcfa,
        campaign_vs_invoiced_variance_fcfa,
        impressions,
        clicks
    FROM "awale"."main"."mart_marketing_channel_monthly"

),

sales AS (

    SELECT
        month,
        net_revenue_fcfa,
        net_units_sold,
        gross_revenue_fcfa,
        return_revenue_fcfa,
        missing_sales_days
    FROM "awale"."main"."mart_sales_monthly"

)

SELECT
    m.month,
    m.channel,

    m.campaign_spend_fcfa,
    m.planned_budget_fcfa,
    m.invoiced_fcfa,
    m.campaign_vs_invoiced_variance_fcfa,

    m.impressions,
    m.clicks,

    s.net_revenue_fcfa,
    s.net_units_sold,
    s.gross_revenue_fcfa,
    s.return_revenue_fcfa,
    s.missing_sales_days

FROM marketing m

LEFT JOIN sales s
    ON m.month = s.month
    );
    
  
